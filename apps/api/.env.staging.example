ENVIRONMENT=staging
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
JWT_SECRET=replace_with_strong_staging_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=https://staging.4-craft.com
FRONTEND_BASE_URL=https://staging.4-craft.com
BACKEND_BASE_URL=https://api-staging.4-craft.com

REDIS_URL=redis://USER:PASSWORD@HOST:PORT/0
MINIO_ENDPOINT=s3-or-minio-staging-endpoint
MINIO_ACCESS_KEY=replace_with_staging_access_key
MINIO_SECRET_KEY=replace_with_staging_secret_key

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_EP_FOUNDER_MONTHLY=price_test_xxx
STRIPE_PRICE_TH_FOUNDER_MONTHLY=price_test_xxx
STRIPE_PRICE_EP_PLUS_MONTHLY=price_test_xxx
STRIPE_PRICE_TH_PLUS_MONTHLY=price_test_xxx
STRIPE_PRICE_EP_PLUS_YEARLY_PROMO=price_test_xxx
STRIPE_PRICE_TH_PLUS_YEARLY_PROMO=price_test_xxx
