ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=topa_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

CORS_ORIGINS=https://staging.4-craft.com
FRONTEND_BASE_URL=https://staging.4-craft.com
BACKEND_BASE_URL=https://api-staging.4-craft.com

REDIS_URL=redis://USER:PASSWORD@HOST:PORT/0
MINIO_ENDPOINT=s3-or-minio-staging-endpoint
MINIO_ACCESS_KEY=replace_with_staging_access_key
MINIO_SECRET_KEY=replace_with_staging_secret_key

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_EP_FOUNDER_MONTHLY=price_test_xxx
STRIPE_PRICE_TH_FOUNDER_MONTHLY=price_test_xxx
