# Copy to .env.docker for Docker Desktop beta runs:
#   Copy-Item .env.docker.example .env.docker
#   docker compose --env-file .env.docker -f docker-compose.beta.yml up -d --build

ENVIRONMENT=local

POSTGRES_DB=adaptive_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_local_beta_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change_this_local_beta_password@4craft-postgres:5432/adaptive_learning

REDIS_PORT=6379
REDIS_URL=redis://4craft-redis:6379/0

API_PORT=8001
WEB_PORT=3000

JWT_SECRET=replace_with_a_local_docker_beta_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8001

# Browser-side URL. Keep localhost for local Docker Desktop beta.
NEXT_PUBLIC_APP_ENV=beta
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Server-side Next.js rewrites inside Docker network.
INTERNAL_API_BASE_URL=http://4craft-api:8001

# ─── Stripe Billing (required for paid plans) ───────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys (use test-mode keys for dev)
# STRIPE_SECRET_KEY=sk_test_...        # Server-side only — never expose to browser
# STRIPE_WEBHOOK_SECRET=whsec_...      # From Stripe Webhooks dashboard — required for webhook verification
#
# Price IDs from Stripe Dashboard -> Products -> select a product -> copy Price ID
# Format: price_... (starts with "price_", NOT "prod_")
#
# TH Plans
# STRIPE_PRICE_TH_PLUS_MONTHLY=price_...       # Plus TH Monthly (฿299/mo)
# STRIPE_PRICE_TH_PLUS_YEARLY_PROMO=price_...  # Plus TH Yearly Promo (฿2990/yr)
# STRIPE_PRICE_TH_FOUNDER_MONTHLY=price_...     # Plus TH Founder Monthly (฿199/mo, limited 100 slots)
#
# EP Plans
# STRIPE_PRICE_EP_PLUS_MONTHLY=price_...       # Plus EP Monthly (฿599/mo)
# STRIPE_PRICE_EP_PLUS_YEARLY_PROMO=price_...  # Plus EP Yearly Promo (฿5990/yr)
# STRIPE_PRICE_EP_FOUNDER_MONTHLY=price_...    # Plus EP Founder Monthly (฿399/mo, limited 100 slots)
#
# Stripe Customer Portal return URL (after managing billing)
# STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://topamath.com/dashboard

# Keep Stripe test-mode only. Do not place live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EP_FOUNDER_MONTHLY=
STRIPE_PRICE_TH_FOUNDER_MONTHLY=
STRIPE_PRICE_EP_PLUS_MONTHLY=
STRIPE_PRICE_TH_PLUS_MONTHLY=
STRIPE_PRICE_EP_PLUS_YEARLY_PROMO=
STRIPE_PRICE_TH_PLUS_YEARLY_PROMO=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/dashboard

MINIMAX_API_KEY=

# Cloudflare Tunnel (Zero Trust -> Access -> Tunnels -> <tunnel name> -> Token)
CLOUDFLARE_TUNNEL_TOKEN=
