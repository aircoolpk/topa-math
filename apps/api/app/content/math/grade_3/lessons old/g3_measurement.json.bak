{
  "lesson_id": "g3_measurement",
  "id": "g3_measurement",
  "grade_level": 3,
  "title_th": "การวัดความยาวและน้ำหนัก",
  "objective_th": "เข้าใจเรื่องการวัดความยาวและน้ำหนักจากสถานการณ์จริง ใช้แผนภาพและประโยควิธีทำได้ถูกต้อง",
  "story_intro_th": "น้องข้าวหอมช่วยเพื่อนกลุ่มศิลปะรวบรวมดินสอสีสำหรับกิจกรรมที่โต๊ะศิลปะ กล่องแรกมี 45 ชิ้น และในกล่องสีอีกใบมี 28 ชิ้น ก่อนแจกให้เพื่อน ๆ น้องข้าวหอมต้องหาว่ามีดินสอสีทั้งหมดกี่ชิ้น เพื่อเตรียมจำนวนให้พอดีกับทุกคนในห้อง โจทย์นี้ฝึกแนวคิดการวัดความยาวและน้ำหนักผ่านภารกิจที่ลานกิจกรรม เด็ก ๆ ต้องจัดแถวของให้ตรงกับเส้นสีแดงหลังซ้อมร้องเพลง ครูให้จับคู่กันอ่านโจทย์และวงตัวเลขสำคัญ เพราะคำถามต้องการคำตอบที่สัมพันธ์กับสถานการณ์โดยตรง",
  "explanation_steps": [
    "ความยาวใช้หน่วย เซนติเมตร (ซม.) เมตร (ม.) กิโลเมตร (กม.)",
    "1 เมตร = 100 เซนติเมตร / 1 กิโลเมตร = 1000 เมตร",
    "น้ำหนักใช้หน่วย กรัม (ก.) กิโลกรัม (กก.) / 1 กิโลกรัม = 1000 กรัม",
    "ปริมาตรใช้หน่วย มิลลิลิตร (มล.) ลิตร (ล.) / 1 ลิตร = 1000 มิลลิลิตร",
    "เลือกหน่วยที่เหมาะสมกับขนาดของสิ่งที่วัด"
  ],
  "worked_examples": [
    {
      "title_th": "แปลงหน่วยความยาว",
      "question_th": "2 เมตร เท่ากับกี่เซนติเมตร?",
      "solution_th": "2 × 100 = 200 เซนติเมตร ✅"
    },
    {
      "title_th": "แปลงหน่วยน้ำหนัก",
      "question_th": "3 กิโลกรัม เท่ากับกี่กรัม?",
      "solution_th": "3 × 1000 = 3000 กรัม ✅"
    },
    {
      "title_th": "เลือกหน่วยที่เหมาะสม",
      "question_th": "น้ำหนักตัวของคนจะใช้หน่วยอะไร?",
      "solution_th": "ใช้กิโลกรัม (เช่น 35 กก.) เพราะกรัมใช้กับของเล็กๆ ✅"
    }
  ],
  "common_mistakes": [
    "แปลงหน่วยผิด เช่น คิดว่า 1 เมตร = 10 เซนติเมตร แทนที่จะเป็น 100",
    "เลือกหน่วยไม่เหมาะสม เช่น บอกความสูงคนเป็นเซนติเมตรแทนเมตร",
    "ไม่เข้าใจว่าหน่วยใหญ่กว่าแปลงเป็นหน่วยเล็กกว่าต้องคูณ หน่วยเล็กกว่าแปลงเป็นหน่วยใหญ่ต้องหาร"
  ],
  "hints": [
    "จำว่า ม. → ซม. คูณ 100 / กก. → ก. คูณ 1000 / ล. → มล. คูณ 1000",
    "ถ้าจำไม่ได้ ให้นึกถึงตารางแปลงหน่วยที่คุ้นเคย เช่น 1 เมตร = 100 ซม. บนไม้บรรทัด",
    "เลือกหน่วยโดยดูว่าสิ่งที่วัดใหญ่แค่ไหน ของใหญ่ใช้หน่วยใหญ่ ของเล็กใช้หน่วยเล็ก"
  ],
