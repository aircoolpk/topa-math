# Local environment and secrets
.env
.env.*
!.env.example
!.env.docker.example
!.env.staging.example
!.env.mpp-staging.example
!.env.production.example
!deploy/.env.production.release.example
.release-backups/

# Dependencies
node_modules/
**/node_modules/

# Lockfile must be committed — `npm ci` (CI + Cloudflare Workers Builds)
# fails without it. This repo's root package-lock.json existed on disk but was
# never added to the index, which broke every CI run.
!package-lock.json
!*/package-lock.json

# Next.js build output
.next/
**/.next/
out/

# Python virtualenvs and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
*.py[cod]

# Local databases
*.db
*.sqlite
*.sqlite3

# Local storage and generated runtime files
storage/
storage/local/
apps/api/storage/
storage/uploads/
apps/api/local/

# Local/scratch tooling containing machine-specific credentials
apps/api/app/content/math/question_banks/moltbook_check.py

# Logs and process output
*.log
*.err.log
*.out.log
stdout.log
stderr.log

# Build/type cache
*.tsbuildinfo
.cache/
**/.cache/

# Local tool/cache folders
.tools/
.hermes/

# OS/editor files
.DS_Store
Thumbs.db

# ── Phase 0 backup artifacts (never commit) ─────────────────────────────
*.bak-phase0
*.bak-phase0-*
docker-compose.beta.yml.bak-*
# Content QA backups (large, regenerable)
apps/api/app/content/math/_content_backups/
# Legacy/backup content folders
apps/api/app/content/math/backup_*/
apps/api/app/content/math/_archived_legacy_not_loaded/
# Stray duplicate content folders (verified 100% duplicate of canonical grade_N/)
apps/api/app/content/math/New folder/
apps/api/app/content/math/grade_*/lessons old/
*.bak-phase1-*

# QA session artifacts (contain auth tokens)
.qa/

# Cloudflare Workers local secrets (wrangler dev)
.dev.vars

# OpenNext / Cloudflare Workers build output
.open-next/
.open-next
.wrangler/
# Neon agent skills lock (the skills themselves live in the ignored .hermes/)
skills-lock.json

# Neon branch context (org/project/branch ids) - the policy neon.ts is committed
.neon

# scratch artifacts from the API port
apps/api-ts/tmp/
apps/api-ts/.parity-fastapi/
src/app/dashboard/lessons/[lessonId]/page.tsx.bak-legacy
