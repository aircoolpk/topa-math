# Example production env for the Topa Math API on a home server behind Cloudflare Tunnel.
# Copy this to .env.production on your server, replace all placeholder secrets, and keep the real file private.

ENVIRONMENT=production

POSTGRES_DB=adaptive_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:replace_with_strong_postgres_password@4craft-postgres:5432/adaptive_learning

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://4craft-redis:6379/0

API_HOST=127.0.0.1
API_PORT=8001

JWT_SECRET=replace_with_at_least_32_random_characters_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUTH_COOKIE_NAME=topa_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

CORS_ORIGINS=https://topamath.com,https://www.topamath.com
FRONTEND_BASE_URL=https://topamath.com
BACKEND_BASE_URL=https://api.topamath.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EP_FOUNDER_MONTHLY=
STRIPE_PRICE_TH_FOUNDER_MONTHLY=
STRIPE_PRICE_EP_PLUS_MONTHLY=
STRIPE_PRICE_TH_PLUS_MONTHLY=
STRIPE_PRICE_EP_PLUS_YEARLY_PROMO=
STRIPE_PRICE_TH_PLUS_YEARLY_PROMO=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://topamath.com/dashboard

AFFILIATE_COMMISSION_RATE_BPS=300
AFFILIATE_COMMISSION_HOLD_DAYS=7
AFFILIATE_MIN_WITHDRAWAL_MINOR=50000
AFFILIATE_ADMIN_NOTIFICATION_EMAIL=

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

MINIMAX_API_KEY=

# Cloudflare Tunnel token from Zero Trust -> Networks -> Tunnels.
# Configure Public Hostname in Cloudflare as:
#   api.topamath.com -> http://4craft-api:8001
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
